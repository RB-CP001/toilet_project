<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qt_ui</name>
  <version>0.0.0</version>
  <description>Qt HMI for the toilet cleaning robot. Starts and monitors the cleaning_manager node.</description>
  <maintainer email="fjrzl7a03@gmail.com">rokey</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>dsr_msgs2</depend>
  <depend>toilet_cleaning_interfaces</depend>

  <exec_depend>toilet_cleaning</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
