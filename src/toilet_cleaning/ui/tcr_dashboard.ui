  <property name="styleSheet">
   <string notr="true">#Dashboard { background:#07090F; }

QFrame#header { background:#0C0F1A; border:none; border-bottom:1px solid #1B2032; }
QFrame#logHead { background:transparent; border:none; border-bottom:1px solid #1B2032; }
QFrame#lineDiv { background:#262C40; border:none; }

QFrame#cardHero {
    background:#0C0F1A; border:1px solid #1B2032; border-radius:20px;
}
QFrame#cardStepper, QFrame#cardLog {
    background:#0C0F1A; border:1px solid #1B2032; border-radius:16px;
}

QLabel { color:#8A91A8; background:transparent; border:none; }
QLabel#lblTitle { color:#E8EAF0; }
QLabel#lblUnit, QLabel#lblEyebrow, QLabel#lblTotalCaption, QLabel#lblLogCaption { color:#3D445A; }
QLabel#lblTitleKo { color:#E8EAF0; }
QLabel#lblLive { color:#00D87A; }
QLabel#lblSingleKo, QLabel#lblHomeKo, QLabel#lblResetKo { color:#E8EAF0; }
QLabel#lblSingleEn, QLabel#lblHomeEn, QLabel#lblResetEn { color:#3D445A; }
QLabel#lblStopText { color:#FF4C5E; }
QLabel#lblKnob { background:#FF4C5E; border:none; border-radius:13px; }

QPushButton#btnMain {
    background:#111527; color:#8A91A8;
    border:1px solid #1B2032; border-radius:16px;
}
QPushButton#btnConn {
    color:#00D87A; background:#0D1A1C;
    border:1px solid #16332C; border-radius:13px; padding:0 8px;
}

QTextEdit#txtLog { background:transparent; border:none; padding:6px 12px; }
QScrollBar:vertical { background:transparent; width:4px; margin:4px; }
QScrollBar::handle:vertical { background:#262C40; border-radius:2px; }
QScrollBar::add-line, QScrollBar::sub-line { height:0; }</string>
